DB_CLIENT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_CONNECT_TIMEOUT=3000
DB_USER=ozledger
DB_PASSWORD=replace_me
DB_NAME=ozledger
# Only enable for local development. Production must fail if MySQL is down.
ALLOW_SQLITE_FALLBACK=false
# Comma-separated browser origins allowed to call the API in production.
# Example: https://ledger.example.com
ALLOWED_ORIGINS=
